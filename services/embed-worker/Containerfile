# memoire-embed image (D218 vector lane). Model files are baked at build
# time and the runtime is pinned offline (MEMOIRE_EMBED_LOCAL_ONLY=1) —
# the hub never fetches from HF. The offline `verify` step runs through
# the exact runtime load path, so a cache-layout surprise fails this
# build instead of the cluster.
FROM node:22-bookworm-slim
WORKDIR /app
COPY services/embed-worker/package.json services/embed-worker/package-lock.json ./
RUN npm ci --no-audit --fund=false
COPY services/embed-worker/src ./src
COPY services/embed-worker/scripts ./scripts
ENV MEMOIRE_EMBED_MODEL_DIR=/app/models
RUN node scripts/model-tool.mjs fetch \
 && MEMOIRE_EMBED_LOCAL_ONLY=1 node scripts/model-tool.mjs verify
# The runtime is plain `node` (CMD below) — npm/npx/corepack were needed
# only for `npm ci` above. Strip the base's bundled npm toolchain so its
# internal deps (tar, brace-expansion, … — the node-pkg findings the
# fleet scan gate blocks on) never ship in the runtime image.
RUN rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
ENV MEMOIRE_EMBED_LOCAL_ONLY=1
ENV NODE_ENV=production
EXPOSE 37779
CMD ["node", "src/index.mjs", "serve"]
