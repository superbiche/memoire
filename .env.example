MEMOIRE_ADDR=127.0.0.1:37778
MEMOIRE_HOME=./tmp/memoire-home
MEMOIRE_DB=./tmp/memoire-home/memoire.db
MEMOIRE_SCHEMA_DIR=./schema

# Model endpoint registry for the -execute derivation path. Defaults to
# $MEMOIRE_HOME/model-endpoints.json. See model-endpoints.example.json for the
# shape. api_key_env names the env var holding the bearer token (env-var-by-name,
# D73); the token value is never stored in config.
MEMOIRE_MODEL_ENDPOINTS=./tmp/memoire-home/model-endpoints.json

# Bearer tokens for local model endpoints, resolved by NAME at call time. Never
# committed; set in your shell/secret manager. Names must match api_key_env in
# the endpoint registry.
# HL3_QWEN_API_KEY=
# LLAMA_API_KEY_HL5=

